# ===== 火山引擎配置 =====
# 火山引擎控制台获取：https://console.volcengine.com/speech/service/8
VOLC_APPID=your_app_id_here
VOLC_ACCESS_TOKEN=your_access_token_here

# 豆包文本大模型（用于会议纪要）
